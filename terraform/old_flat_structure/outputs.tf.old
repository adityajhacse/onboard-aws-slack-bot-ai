# API Gateway Outputs
output "api_gateway_url" {
  description = "API Gateway invoke URL"
  value       = "${aws_api_gateway_stage.onboarding.invoke_url}/onboard"
}

output "api_gateway_id" {
  description = "API Gateway REST API ID"
  value       = aws_api_gateway_rest_api.onboarding.id
}

output "api_status_url" {
  description = "API Gateway status check URL"
  value       = "${aws_api_gateway_stage.onboarding.invoke_url}/status"
}

# Step Functions Outputs
output "state_machine_arn" {
  description = "Step Functions state machine ARN"
  value       = aws_sfn_state_machine.onboarding.arn
}

output "state_machine_name" {
  description = "Step Functions state machine name"
  value       = aws_sfn_state_machine.onboarding.name
}

# Lambda Function Outputs
output "lambda_function_arns" {
  description = "ARNs of all Lambda functions"
  value = {
    validate_intake      = aws_lambda_function.validate_intake.arn
    github_branch        = aws_lambda_function.github_branch.arn
    github_commit        = aws_lambda_function.github_commit.arn
    hcp_project          = aws_lambda_function.hcp_project.arn
    hcp_workspace        = aws_lambda_function.hcp_workspace.arn
    hcp_vars             = aws_lambda_function.hcp_vars.arn
    status_tracker       = aws_lambda_function.status_tracker.arn
    completion_notifier  = aws_lambda_function.completion_notifier.arn
  }
}

output "lambda_layer_arn" {
  description = "ARN of the shared Lambda layer"
  value       = aws_lambda_layer_version.shared_layer.arn
}

# DynamoDB Outputs
output "dynamodb_table_name" {
  description = "DynamoDB table name for execution tracking"
  value       = aws_dynamodb_table.executions.name
}

output "dynamodb_table_arn" {
  description = "DynamoDB table ARN"
  value       = aws_dynamodb_table.executions.arn
}

output "dynamodb_logs_table_name" {
  description = "DynamoDB table name for execution logs"
  value       = aws_dynamodb_table.execution_logs.name
}

output "dynamodb_logs_table_arn" {
  description = "DynamoDB table ARN for execution logs"
  value       = aws_dynamodb_table.execution_logs.arn
}

# CloudWatch Log Groups
output "cloudwatch_log_groups" {
  description = "CloudWatch Log Group names"
  value = {
    step_functions       = aws_cloudwatch_log_group.step_functions.name
    api_gateway          = aws_cloudwatch_log_group.api_gateway.name
    validate_intake      = aws_cloudwatch_log_group.validate_intake.name
    github_branch        = aws_cloudwatch_log_group.github_branch.name
    github_commit        = aws_cloudwatch_log_group.github_commit.name
    hcp_project          = aws_cloudwatch_log_group.hcp_project.name
    hcp_workspace        = aws_cloudwatch_log_group.hcp_workspace.name
    hcp_vars             = aws_cloudwatch_log_group.hcp_vars.name
    status_tracker       = aws_cloudwatch_log_group.status_tracker.name
    completion_notifier  = aws_cloudwatch_log_group.completion_notifier.name
  }
}

# IAM Role ARNs
output "iam_roles" {
  description = "IAM role ARNs"
  value = {
    lambda_execution = aws_iam_role.lambda_execution.arn
    step_functions   = aws_iam_role.step_functions.arn
    api_gateway      = aws_iam_role.api_gateway.arn
  }
}

# Deployment Information
output "deployment_info" {
  description = "Deployment information for integration"
  value = {
    region             = local.region
    account_id         = local.account_id
    api_endpoint       = "${aws_api_gateway_stage.onboarding.invoke_url}/onboard"
    status_endpoint    = "${aws_api_gateway_stage.onboarding.invoke_url}/status"
    state_machine_arn  = aws_sfn_state_machine.onboarding.arn
    dynamodb_table     = aws_dynamodb_table.executions.name
  }
}
