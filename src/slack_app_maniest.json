{
    "display_information": {
        "name": "aws-det-bot-poc",
        "description": "A bot for account Requests in AWS",
        "background_color": "#005c91",
        "long_description": "Whether you are scaling a startup or managing a large enterprise footprint, the aws-det-bot-poc is your first step toward a more intelligent, automated, and conversational cloud infrastructure."
    },
    "features": {
        "bot_user": {
            "display_name": "aws-det-bot-poc",
            "always_online": false
        },
        "slash_commands": [
            {
                "command": "/aws-det-poc",
                "description": "aws-det-poc",
                "should_escape": false
            },
            {
                "command": "/aws-det-onboard",
                "description": "aws-det-onboard",
                "should_escape": false
            }
        ]
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "im:history",
                "channels:join",
                "chat:write",
                "chat:write.public",
                "commands",
                "im:read",
                "im:write",
                "mpim:write",
                "channels:history",
                "groups:history",
                "mpim:history"
            ]
        },
        "pkce_enabled": false
    },
    "settings": {
        "event_subscriptions": {
            "bot_events": [
                "message.channels",
                "message.groups",
                "message.im",
                "message.mpim"
            ]
        },
        "interactivity": {
            "is_enabled": true
        },
        "org_deploy_enabled": false,
        "socket_mode_enabled": true,
        "token_rotation_enabled": false,
        "is_mcp_enabled": false
    }
}